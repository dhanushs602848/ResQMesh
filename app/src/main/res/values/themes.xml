<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme for Jetpack Compose -->
    <style name="Theme.ResQMesh" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash screen theme using androidx.core:core-splashscreen -->
    <style name="Theme.ResQMesh.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050810</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ResQMesh</item>
    </style>

</resources>
